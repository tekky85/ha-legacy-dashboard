# Standalone/LXC mode only. Keep the real file server-side and mode 0600.
HA_URL=http://homeassistant.example:8123
HA_TOKEN=replace-with-a-long-lived-access-token

# Optional. The Admin API remains disabled unless explicitly enabled.
ADMIN_API_ENABLED=false
# ADMIN_TOKEN=replace-with-a-separate-strong-secret
# Protected Admin JSON only; default 1 MiB, allowed 16384..16777216 bytes.
# Light/Climate request bodies remain limited to 16 KiB.
# ADMIN_CONFIG_MAX_BYTES=1048576

PORT=3000
BIND_ADDRESS=0.0.0.0
