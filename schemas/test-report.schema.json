{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://tekky85.github.io/ha-legacy-dashboard/testing/schemas/test-report.schema.json",
  "title": "Community manual test report 1.0",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "testRunId", "testerId", "createdAt", "updatedAt", "catalogVersion", "catalogHash", "environment", "notes", "issueUrl", "results"],
  "properties": {
    "schemaVersion": {"const": "1.0"},
    "testCenterVersion": {"type": "string", "minLength": 1, "maxLength": 80},
    "dataKind": {"enum": ["manual", "synthetic"]},
    "exportedAt": {"type": "string", "format": "date-time"},
    "testRunId": {"type": "string", "pattern": "^RUN-[A-Za-z0-9-]{8,80}$"},
    "testerId": {"type": "string", "minLength": 1, "maxLength": 80},
    "createdAt": {"type": "string", "format": "date-time"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "catalogVersion": {"type": "string", "minLength": 1, "maxLength": 100},
    "catalogHash": {"type": "string", "pattern": "^[a-f0-9]{64}$"},
    "environment": {
      "type": "object", "additionalProperties": false,
      "required": ["deployment", "dashboardVersion", "homeAssistantVersion", "architecture", "browser", "device", "os"],
      "properties": {
        "deployment": {"enum": ["ha-app", "standalone"]},
        "dashboardVersion": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[A-Za-z0-9.-]+)?$", "maxLength": 160},
        "homeAssistantVersion": {"type": "string", "maxLength": 160},
        "architecture": {"type": "string", "maxLength": 160},
        "browser": {"type": "string", "minLength": 1, "maxLength": 160},
        "device": {"type": "string", "minLength": 1, "maxLength": 160},
        "os": {"type": "string", "minLength": 1, "maxLength": 160}
      }
    },
    "notes": {"$ref": "#/$defs/text"},
    "issueUrl": {"$ref": "#/$defs/issue"},
    "results": {"type": "array", "maxItems": 1000, "items": {"$ref": "#/$defs/result"}}
  },
  "$defs": {
    "text": {"type": "string", "maxLength": 4000},
    "issue": {"type": "string", "maxLength": 150, "pattern": "^(?:#[1-9][0-9]{0,9}|https://github\\.com/tekky85/ha-legacy-dashboard/issues/[1-9][0-9]{0,9})?$"},
    "result": {
      "type": "object", "additionalProperties": false,
      "required": ["testId", "status", "testedAt", "expected", "actual", "reproductionSteps", "notes", "issueUrl", "evidence"],
      "properties": {
        "testId": {"type": "string", "pattern": "^MT-[0-9]{2,4}$"},
        "status": {"enum": ["PASS", "FAIL", "BLOCKED", "NOT_TESTED", "N/A"]},
        "testedAt": {"type": ["string", "null"], "format": "date-time"},
        "expected": {"$ref": "#/$defs/text"}, "actual": {"$ref": "#/$defs/text"},
        "reproductionSteps": {"$ref": "#/$defs/text"}, "notes": {"$ref": "#/$defs/text"},
        "issueUrl": {"$ref": "#/$defs/issue"}, "evidence": {"$ref": "#/$defs/text"}
      },
      "allOf": [
        {"if": {"properties": {"status": {"const": "FAIL"}}}, "then": {"properties": {"expected": {"minLength": 1}, "actual": {"minLength": 1}, "reproductionSteps": {"minLength": 1}}}},
        {"if": {"properties": {"status": {"enum": ["BLOCKED", "N/A"]}}}, "then": {"properties": {"notes": {"minLength": 1}}}},
        {"if": {"properties": {"status": {"enum": ["PASS", "FAIL", "BLOCKED", "N/A"]}}}, "then": {"properties": {"testedAt": {"type": "string"}}}}
      ]
    }
  }
}
